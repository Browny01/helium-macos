--- /dev/null
+++ src/chrome/browser/ui/helium/vertical_tab_density.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_VERTICAL_TAB_DENSITY_H_
+#define CHROME_BROWSER_UI_HELIUM_VERTICAL_TAB_DENSITY_H_
+
+#include "base/component_export.h"
+
+// The density of the vertical tab strip. This must be kept in sync with the
+// VerticalTabDensity enum in
+// chrome/browser/resources/settings/appearance_page/appearance_page.ts.
+enum class VerticalTabDensity {
+  kCompact = 0,
+  kRoomy = 1,
+  kMaxValue = kRoomy,
+};
+
+// Missing or invalid preference values use Compact.
+constexpr VerticalTabDensity NormalizeVerticalTabDensity(int value) {
+  return value == static_cast<int>(VerticalTabDensity::kRoomy)
+             ? VerticalTabDensity::kRoomy
+             : VerticalTabDensity::kCompact;
+}
+
+// Returns the process-wide vertical tab density. GetLayoutConstant() uses this
+// to derive vertical tab metrics. Defaults to kCompact.
+COMPONENT_EXPORT(HELIUM_VERTICAL_TAB_DENSITY)
+VerticalTabDensity GetVerticalTabDensity();
+
+// Sets the process-wide vertical tab density. This is updated by
+// VerticalTabStripStateController from the browser-wide Local State preference.
+// Every window observes the same preference, including across profiles.
+COMPONENT_EXPORT(HELIUM_VERTICAL_TAB_DENSITY)
+void SetVerticalTabDensity(VerticalTabDensity density);
+
+#endif  // CHROME_BROWSER_UI_HELIUM_VERTICAL_TAB_DENSITY_H_
