+void VerticalTabStripRegionView::RefreshDensity() {
+  UpdateInteriorMargin();
+  auto invalidate_subtree = [](auto&& self, views::View* view) -> void {
+    for (views::View* child : view->children()) {
+      self(self, child);
+    }
+    view->InvalidateLayout();
+  };
+  invalidate_subtree(invalidate_subtree, this);
+}
